# Browser-safe configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase access. Never expose this value with NEXT_PUBLIC_ and
# never commit a real value to this file.
SUPABASE_SERVICE_ROLE_KEY=

# Keep model selection centralized here. Routes fail closed when a required model is unset.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-5.5
OPENAI_STYLIST_MODEL=gpt-5.5
OPENAI_PLANNER_MODEL=gpt-5.5
OPENAI_RESEARCH_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=high

# Weather
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_CACHE_TTL_SECONDS=900

# Private storage and signed URLs
WARDROBE_ORIGINALS_BUCKET=wardrobe-originals
WARDROBE_ITEMS_BUCKET=wardrobe-items
WARDROBE_LABELS_BUCKET=wardrobe-labels
WARDROBE_GENERATED_BUCKET=wardrobe-generated
PROFILE_REFERENCES_BUCKET=profile-references
SIGNED_URL_TTL_SECONDS=300

# Expensive-operation protection. Generate each with: openssl rand -hex 32
IMPORT_WORKER_SECRET=
CRON_SECRET=
# Optional: dedicated secret for the wardrobe-compilation worker. Falls back to
# IMPORT_WORKER_SECRET/CRON_SECRET when unset. See docs/deployment.md.
WARDROBE_COMPILATION_WORKER_SECRET=
# Import/research enqueue limits are fixed in the protected database feature_limits table.
DAILY_IMAGE_LIMIT=20
DAILY_STYLIST_LIMIT=40
DAILY_PLANNER_LIMIT=10
STYLIST_RATE_LIMIT_PER_MINUTE=5
PLANNER_RATE_LIMIT_PER_MINUTE=2
IMAGE_RATE_LIMIT_PER_MINUTE=3

# Optional: bound the precomputed outfit-candidate library's size. Unset uses
# a dynamic default based on wardrobe size (see generateOutfitCandidates()).
WARDROBE_COMPILATION_MAX_CANDIDATES=
WARDROBE_COMPILATION_MAX_FOUNDATIONS_PER_BUCKET=
