# Browser-safe configuration. NEXT_PUBLIC_APP_URL is the canonical origin every
# email link and OAuth redirect is built from -- it must exactly match the Site
# URL configured in Supabase, or those links will point at the wrong host.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase access. Never expose this value with NEXT_PUBLIC_ and
# never commit a real value to this file.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Authentication
#
# Provider secrets are deliberately absent from this file. The Google client
# secret, the Turnstile secret, and the SMTP credentials all belong in
# Supabase/Google/SMTP configuration, because Supabase -- not this application
# -- is what redeems an OAuth code, verifies a CAPTCHA token, and sends mail.
# See docs/authentication.md and docs/auth-production-checklist.md.
# ---------------------------------------------------------------------------

# Server-enforced. When false, /api/auth/signup refuses to create an account no
# matter what the browser posts, and the signup page says it is invite-only.
PUBLIC_SIGNUP_ENABLED=false

# Google OAuth. Enable only after the provider is configured in Supabase and
# the exact redirect URIs are registered in the Google console. When false, the
# button is not rendered at all rather than shown disabled.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Optional passwordless sign-in for accounts that already exist. Never creates
# a user, so it cannot be used to bypass the signup flag or the Terms record.
NEXT_PUBLIC_EMAIL_MAGIC_LINK_ENABLED=false

# Cloudflare Turnstile. Set the site key here and the matching *secret* in
# Supabase's CAPTCHA settings -- Supabase is what validates the token. Enabling
# the flag without a site key is a hard startup error, never a silent bypass.
NEXT_PUBLIC_CAPTCHA_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Signs the one-time challenges behind password reset and deletion
# reauthentication. Rotating it invalidates every in-flight reset link.
# Generate with: openssl rand -hex 32
AUTH_ACTION_SECRET=

# Turns emails and IP addresses into opaque pre-auth rate-limit buckets, so the
# limiter stores no raw identifier. Rotating it resets every active window.
# Generate with: openssl rand -hex 32
AUTH_RATE_LIMIT_HMAC_SECRET=

# Name of the client-IP header your reverse proxy *overwrites*. On Vercel use
# x-vercel-forwarded-for. Leave unset locally and anywhere the header could be
# client-supplied: unset means IP buckets collapse to one shared bucket, which
# is weaker but honest, whereas trusting a forgeable header would let an
# attacker mint a fresh bucket per request.
TRUSTED_CLIENT_IP_HEADER=

# Keep model selection centralized here. Routes fail closed when a required model is unset.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-5.5
OPENAI_STYLIST_MODEL=gpt-5.5
OPENAI_PLANNER_MODEL=gpt-5.5
OPENAI_RESEARCH_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=high
OPENAI_CURATOR_MODEL=gpt-5.5

# Weather
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_CACHE_TTL_SECONDS=900

# Private storage and signed URLs
WARDROBE_ORIGINALS_BUCKET=wardrobe-originals
WARDROBE_ITEMS_BUCKET=wardrobe-items
WARDROBE_LABELS_BUCKET=wardrobe-labels
WARDROBE_GENERATED_BUCKET=wardrobe-generated
PROFILE_REFERENCES_BUCKET=profile-references
SIGNED_URL_TTL_SECONDS=300

# Expensive-operation protection. Generate each with: openssl rand -hex 32
IMPORT_WORKER_SECRET=
CRON_SECRET=
# Optional: dedicated secret for the wardrobe-compilation worker. Falls back to
# IMPORT_WORKER_SECRET/CRON_SECRET when unset. See docs/deployment.md.
WARDROBE_COMPILATION_WORKER_SECRET=
# Import/research enqueue limits are fixed in the protected database feature_limits table.
DAILY_IMAGE_LIMIT=20
DAILY_STYLIST_LIMIT=40
DAILY_PLANNER_LIMIT=10
STYLIST_RATE_LIMIT_PER_MINUTE=5
PLANNER_RATE_LIMIT_PER_MINUTE=2
IMAGE_RATE_LIMIT_PER_MINUTE=3
# Deterministic wardrobe lookups and insights call no model and spend no daily
# generation quota, so a rolling abuse limit is their only ceiling.
WARDROBE_QUERY_RATE_LIMIT_PER_MINUTE=20
# Bounds how often ambiguous chat text may escalate to the classifier model.
# Routing is never billed as a generation, so this is what keeps it metered.
INTENT_CLASSIFICATION_RATE_LIMIT_PER_MINUTE=10

# Optional: bound the precomputed outfit-candidate library's size. Unset uses
# a dynamic default based on wardrobe size (see generateOutfitCandidates()).
WARDROBE_COMPILATION_MAX_CANDIDATES=
WARDROBE_COMPILATION_MAX_FOUNDATIONS_PER_BUCKET=

# Outfit Curator Agent: bounded compile-time fashion-judgment pass over the
# deterministic candidate library. Missing OPENAI_CURATOR_MODEL never blocks
# compilation -- candidates simply stay curator_status='not_reviewed' and the
# deterministic library remains the fully usable fallback.
WARDROBE_CURATOR_MAX_CANDIDATES=40
WARDROBE_CURATOR_MAX_CALLS_PER_COMPILATION=2
WARDROBE_CURATOR_MAX_SELECTED_PER_NEW_ITEM=5
DAILY_CURATOR_CALL_LIMIT=20
OUTFIT_ANALYSIS_CACHE_TTL_DAYS=90

# Modeled preview worker: renders a small number of private try-on images for
# consented users only. Falls back to WARDROBE_COMPILATION_WORKER_SECRET/
# IMPORT_WORKER_SECRET/CRON_SECRET when unset.
OUTFIT_PREVIEW_WORKER_SECRET=
PREVIEW_MAX_AUTO_PER_UPLOAD=5
PREVIEW_DAILY_LIMIT=30
PREVIEW_MAX_QUEUED_PER_USER=5
PREVIEW_FREQUENTLY_SUGGESTED_THRESHOLD=3

# ---------------------------------------------------------------------------
# Outfit Studio -- interactive AI try-on visualizations.
# ---------------------------------------------------------------------------
# Structured vision model that runs the quality gate and hotspot localization.
# Leave unset to keep try-on disabled: it fails closed with a typed 503 rather
# than serving an image that was never fidelity-checked.
OPENAI_VISUALIZATION_QA_MODEL=
# Which parameters the configured OPENAI_IMAGE_MODEL actually accepts. This is
# a capability profile, NOT a model name.
#   auto_fidelity          -- model applies high input fidelity automatically
#                             and rejects an explicit input_fidelity parameter
#   explicit_high_fidelity -- model requires input_fidelity to be sent
# Change only after running an authorized non-production smoke test; the value
# is part of the visualization freshness hash, so changing it re-generates
# every existing try-on. See docs/outfit-studio.md.
OPENAI_IMAGE_CAPABILITY_PROFILE=auto_fidelity
# "fake" is a deterministic, network-free provider for development and tests
# only. Production must leave this at "openai" -- the fake is never used as a
# silent fallback when configuration is missing.
OUTFIT_VISUALIZATION_PROVIDER=openai
# Scripts the fake provider: ready | qa_fail | transient_once | moderation
OUTFIT_VISUALIZATION_FAKE_OUTCOME=
# Falls back to OUTFIT_PREVIEW_WORKER_SECRET/IMPORT_WORKER_SECRET/CRON_SECRET.
OUTFIT_VISUALIZATION_WORKER_SECRET=
# The paid try-on budget is NOT configured here. request_outfit_visualization()
# is callable by authenticated users, so a limit passed to it as an argument
# would be a limit the client could raise. Its daily budget lives in the
# feature_limits table (outfit_visualization_generation, default 10) and its
# queue/rate caps are constants inside the function.
#
# Identity-photo confirmation runs a paid vision call, so it is budgeted like
# every other model-backed route.
IDENTITY_ASSESSMENT_DAILY_LIMIT=10
IDENTITY_ASSESSMENT_RATE_LIMIT_PER_MINUTE=3
# The download route proxies image bytes, so it gets its own ceiling.
VISUALIZATION_DOWNLOAD_RATE_LIMIT_PER_MINUTE=20
# Lets an owning user's request render their own queued job inline instead of
# waiting for a scheduler. Off by default: a long paid image call does not
# belong in a normal route-handler lifecycle. Useful for local development.
VISUALIZATION_INLINE_PROCESSING_ENABLED=false
