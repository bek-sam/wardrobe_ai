{
  "name": "@wardrobe/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=../.env.local dist/main.js",
    "build": "tsc -p tsconfig.json && node scripts/resolve-imports.mjs",
    "start": "node --env-file-if-exists=../.env.local dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@wardrobe/contracts": "0.1.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
