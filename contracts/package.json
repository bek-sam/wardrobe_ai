{
  "name": "@wardrobe/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./public-api": {
      "types": "./dist/public-api.d.ts",
      "default": "./dist/public-api.js"
    },
    "./ai-private-api": {
      "types": "./dist/ai-private-api.d.ts",
      "default": "./dist/ai-private-api.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    }
  },
  "files": [
    "dist",
    "public-api",
    "ai-private-api",
    "events"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
